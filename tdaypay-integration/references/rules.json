  "callbackRules": {
    "sourceIds": ["tdaypay-webhook"],
    "transport": {"method": "POST", "bodyFormat": "JSON", "urlScheme": "https", "contentTypeHeaderDocumented": false},
    "signature": {
      "header": "sign",
      "algorithm": "SHA512",
      "input": "rawBody + merchantKey",
      "encoding": "UTF-8",
      "output": "SHA512 hexadecimal; examples are lowercase but letter case is not explicitly specified"
    },
    "requiredFields": ["mchOrderId", "orderId", "orderStatus", "amount", "orderType", "createTime"],
    "optionalFields": ["bankId", "failMessage", "transIds", "payMethod"],
    "unclassifiedFields": ["realAmount"],
    "orderStatuses": ["SUCCESS", "FAILED", "REVERSED", "PAYING", "REFUND"],
    "orderTypes": ["PAYMENT", "PAYOUT"],
    "unresolvedOrderStatuses": ["REFUND"],
    "amountPattern": "^\\d+\\.\\d{2}$",
    "createTimeFormat": "%Y%m%d%H%M%S",
    "createTimeTimezone": "UTC",
    "acknowledgement": {
      "httpStatus": 200,
      "body": "success",
      "after": "authenticated event and processing outcome are durably recorded",
      "documentedAttempts": 7,
      "attemptCountIncludesInitial": "unspecified",
      "retryDelay": "5 minutes multiplied by callback attempt number; starting index is unspecified"
    },
    "callbackIps": {
      "latin": ["18.228.164.232", "18.228.73.43", "54.233.252.236", "54.94.8.45"],
      "asia": ["13.200.70.4", "15.207.47.92", "3.108.48.106", "43.205.72.188"]
    },
    "stateRules": [
      "Callbacks may be repeated; process side effects idempotently.",
      "SUCCESS can later become REVERSED.",
      "FAILED can later become SUCCESS, including payout.",
      "Preserve distinct transitions for an order instead of deduplicating by orderId alone."
    ]
  },
  "commonRules": {
    "payment": {
