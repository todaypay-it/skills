      "networkFacts": {
        "SPEI": {
          "providerCapabilityInferred": false,
          "sourceIds": ["banxico-spei", "banxico-spei-circular", "banxico-clabe"],
          "facts": [
            "SPEI transfers are domestic MXN inter-institution transfers; network support does not prove TDayPay merchant enablement.",
            "The network may identify a beneficiary by an 18-digit CLABE, a 16-digit eligible card, or a linked 10-digit mobile number, but TDayPay payout SPEI specifically requires CLABE.",
            "CLABE has 18 digits and a deterministic 3/7/1 checksum; a valid checksum does not prove account ownership or reachability.",
            "1,500 UDIS is a low-value classification threshold, not a universal SPEI maximum.",
            "Liquidado is not final evidence of beneficiary credit; CEP or Confirmación de Abono is the stronger credit evidence.",
            "Do not promise that every SPEI operation is instant and 24/7; detailed timing varies by amount, participant and request type."
          ]
        }
      },
      "notes": []
    },
