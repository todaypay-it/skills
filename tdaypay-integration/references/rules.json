      "networkFacts": {
        "PSE": {"providerCapabilityInferred": false, "sourceIds": ["pse-help"], "facts": ["PSE is an online debit flow from savings, checking or electronic-deposit products; it is not a payout rail.", "A payer registers identity and contact data with PSE; the payer's institution determines the usable payment amount.", "These facts do not prove that a TDayPay merchant is enabled for NET_BANKING/PSE."]},
        "NEQUI": {"providerCapabilityInferred": false, "sourceIds": ["nequi-button"], "facts": ["Botón Nequi requires an eligible Nequi account, sufficient balance and user approval in the app.", "Nequi availability for a merchant does not prove TDayPay route enablement."]},
        "TRANSFIYA": {"providerCapabilityInferred": false, "sourceIds": ["ach-transfiya-rules", "nequi-transfiya-retirement"], "facts": ["ACH Colombia's 2025 rules describe a 24/7/365 low-value immediate system and a 1,000 UVB network ceiling; institutions may set lower limits.", "Nequi states that Transfiya in its app ended on 2025-10-05 and moved to Bre-B, so TDayPay TRANSFIYA with Nequi/507 is a stale-channel conflict requiring current written confirmation.", "Do not automatically rewrite TRANSFIYA to BRE_B."]},
        "BRE_B": {"providerCapabilityInferred": false, "sourceIds": ["banrep-bre-b"], "facts": ["Bre-B supports domestic immediate transfers 24/7/365 through participating institutions.", "A receiver registers a key; a sender only needs the receiver key or QR.", "Key types include national mobile number, identity number, email, an @-prefixed alphanumeric identifier and a merchant code.", "The 2026 network ceiling is 1,000 UVB (12,110,000 COP on the official page), but TDayPay's documented 3,000,000 COP ceiling is lower and remains the conservative provider rule.", "Network participation does not prove TDayPay merchant enablement."]}
      },
