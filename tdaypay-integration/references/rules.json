        "currency": "Required three-letter currency code.",
        "productinfo": "Required product description with 1-100 characters.",
        "firstname": "Required payer first name.",
        "lastname": "Required payer last name.",
        "email": "Required syntactically valid payer email.",
        "phone": "Required payer phone with 6-20 characters; country and channel rules may be stricter."
      },
      "manualConfirmations": [
        "Confirm mchOrderId is unique in the merchant system.",
        "Confirm payer identity and contact fields belong to the actual payer when the country rule requires real identity.",
        "A synchronous orderId or resultCode=000000 proves API acceptance, not final payment completion."
      ]
    },
    "payout": {
