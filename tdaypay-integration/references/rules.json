        "method": "payOut",
        "mchId": "required",
        "signType": "SHA512",
        "timestamp": "Unix timestamp in seconds",
        "sign": "lowercase SHA512 signature over the exact JSON body",
        "Content-Type": "application/json"
      },
      "fieldRules": {
        "mchOrderId": "Required and unique in the merchant system.",
        "amount": "Required, finite, and greater than zero; country and channel rules may be stricter.",
        "currency": "Required three-letter currency code.",
        "purpose": "Required payout purpose or description.",
        "beneficiaryName": "Required beneficiary name; use the legal account-holder name when the receiving bank checks ownership.",
        "beneficiaryEmail": "Required syntactically valid email.",
        "beneficiaryMobile": "Required valid phone; country and channel rules may be stricter.",
        "beneficiaryAccountNumber": "Required bank, wallet, phone, key, or channel-specific identifier."
      },
      "manualConfirmations": [
        "Confirm mchOrderId is unique in the merchant system.",
