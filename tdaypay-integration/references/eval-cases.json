    "action": "payout",
    "strict": true,
    "body": {"mchOrderId": "COPPAYOUT20260914", "amount": "5000", "currency": "COP", "purpose": "Vendor settlement", "beneficiaryName": "Test Recipient", "beneficiaryEmail": "payee@example.com", "beneficiaryMobile": "3001234567", "beneficiaryAccountNumber": "123456789", "paymentType": "NET_BANKING", "beneficiaryBankName": "001", "beneficiaryAccountType": "SAVINGS", "docType": "CC", "docNumber": "12345678", "firstName": "Test", "lastName": "Recipient"},
